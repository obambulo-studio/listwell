{
  "name": "listwell",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "portless run vite dev",
    "dev:localhost": "vite dev --port 3000",
    "build": "vite build && node scripts/after-cf-build.mjs",
    "convex:dev": "npx convex dev",
    "convex:deploy": "npx convex deploy",
    "convex:sync-env": "bash scripts/sync-convex-env.sh",
    "cf:sync-env": "bash scripts/sync-worker-env.sh",
    "cf:sync-build-env": "node scripts/sync-workers-build-env.mjs",
    "preview": "vite build && wrangler dev --config dist/server/wrangler.json",
    "deploy": "vite build && wrangler deploy --config dist/server/wrangler.json --keep-vars",
    "upload": "vite build && wrangler versions upload --config dist/server/wrangler.json",
    "cf:build": "bun run build",
    "cf:preview-deploy": "node scripts/cf-preview-deploy.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "catalog": "bun scripts/generate-check-catalog.ts",
    "smoke:discover": "bash scripts/smoke-discover.sh",
    "test": "vitest run && bun run --cwd packages/audit-engine test",
    "typecheck": "tsc --noEmit && bun run --cwd packages/audit-engine typecheck",
    "check": "bun x ultracite check && bun x -y react-doctor@0.2.1 --verbose --lint -y --offline --fail-on none && bun x tsc --noEmit && bun x -y knip",
    "fix": "ultracite fix",
    "postinstall": "node scripts/patch-wrangler-preview-branch.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vite build && wrangler deploy --config dist/server/wrangler.json --keep-vars"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@cloudflare/puppeteer": "^1.4.0",
    "@convex-dev/better-auth": "^0.12.5",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@listwell/audit-engine": "workspace:*",
    "@polar-sh/sdk": "^0.49.0",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@vinext/cloudflare": "^1.0.1",
    "better-auth": "~1.6.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.124",
    "liveline": "^0.0.7",
    "next": "^16.3.8",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.3.0",
    "recharts": "^3.10.1",
    "shadow-plugin": "^2.1.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vinext": "^1.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1",
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@react-email/render": "^2.1.0",
    "@react-email/ui": "6.11.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "portless": "^0.15.6",
    "typescript": "^7.0.2",
    "ultracite": "7.12.2",
    "vite": "8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  },
  "overrides": {
    "vite": "8.3.2"
  },
  "packageManager": "bun@1.4.2",
  "portless": {
    "name": "listwell"
  }
}

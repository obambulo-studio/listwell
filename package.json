{
  "name": "listwell",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "portless run next dev",
    "dev:localhost": "next dev --port 3000",
    "build": "next build",
    "postbuild": "node scripts/workers-ci-opennext.mjs",
    "prepare": "node scripts/ensure-open-next-placeholder.mjs",
    "convex:dev": "npx convex dev",
    "convex:deploy": "npx convex deploy",
    "convex:sync-env": "bash scripts/sync-convex-env.sh",
    "cf:sync-env": "bash scripts/sync-worker-env.sh",
    "cf:sync-build-env": "node scripts/sync-workers-build-env.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --config wrangler.open-next.jsonc",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --config wrangler.open-next.jsonc",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload --config wrangler.open-next.jsonc",
    "cf:build": "opennextjs-cloudflare build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "catalog": "bun scripts/generate-check-catalog.ts",
    "test": "vitest run && bun run --cwd packages/audit-engine test",
    "typecheck": "tsc --noEmit && bun run --cwd packages/audit-engine typecheck",
    "check": "npx ultracite check && npx -y react-doctor@0.2.1 --verbose --lint -y && tsc --noEmit && npx -y knip",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@convex-dev/better-auth": "^0.12.5",
    "@listwell/audit-engine": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.6",
    "@polar-sh/sdk": "^0.49.0",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "~1.6.30",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "glimm": "^0.3.0",
    "liveline": "^0.0.7",
    "next": "^16.3.4",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "shadow-plugin": "^2.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "portless": "^0.15.6",
    "typescript": "^7.0.2",
    "ultracite": "7.11.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  },
  "portless": {
    "name": "listwell"
  }
}

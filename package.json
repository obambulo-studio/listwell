{
  "name": "listwell",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:build": "opennextjs-cloudflare build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:push": "wrangler d1 execute listwell --local --file=lib/db/migrations/0000.sql",
    "catalog": "bun scripts/generate-check-catalog.ts",
    "test": "vitest run && bun run --cwd packages/audit-engine test",
    "typecheck": "tsc --noEmit && bun run --cwd packages/audit-engine typecheck"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.0.4",
    "@listwell/audit-engine": "workspace:*",
    "@opennextjs/cloudflare": "^1.11.0",
    "drizzle-orm": "^0.44.5",
    "linkedom": "^0.18.12",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "robots-parser": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.2",
    "vitest": "^3.1.4",
    "wrangler": "^4.34.0"
  }
}

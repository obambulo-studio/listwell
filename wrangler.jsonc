{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "listwell",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "listwell"
    }
  ],
  // Browser Rendering Workers binding. Used when a page looks like a thin SPA.
  "browser": {
    "binding": "BROWSER"
  },
  // Workers AI. LIST-3 report briefs call env.AI.run.
  "ai": {
    "binding": "AI"
  }
  // D1, KV, and queues are not declared here. `wrangler versions upload`
  // (Workers Builds PR previews) requires a real database_id / KV id and does
  // not auto-provision. Nil or invented ids fail the same way. LIST-5 already
  // falls back to in-process memory when env.DB / AUDIT_KV are unbound.
  // Local `bun run db:push` uses wrangler.local.jsonc. LIST-8 adds live ids.
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "listwell",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-09",
  // Apex is already production. www is the last LIST-8 gap (HTTP 522).
  // Custom Domains are exact-hostname. middleware.ts 301s www → apex.
  "routes": [
    {
      "pattern": "listwell.dev",
      "zone_name": "listwell.dev",
      "custom_domain": true,
    },
    {
      "pattern": "www.listwell.dev",
      "zone_name": "listwell.dev",
      "custom_domain": true,
    },
  ],
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "placement": {
    "mode": "smart",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },
  "cache": {
    "enabled": true,
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "listwell",
    },
  ],
  "browser": {
    "binding": "BROWSER",
  },
  "ai": {
    "binding": "AI",
  },
  "images": {
    "binding": "IMAGES",
  },
  "kv_namespaces": [
    {
      "binding": "AUDIT_KV",
      "id": "06b74ff3aa6e41a9a5ea7a6eb365e711",
    },
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "listwell-next-cache",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"],
    },
  ],
  "vars": {
    "NEXT_PUBLIC_CONVEX_SITE_URL": "https://hallowed-mallard-135.convex.site",
    "NEXT_PUBLIC_CONVEX_URL": "https://hallowed-mallard-135.convex.cloud",
    "NEXT_PUBLIC_SITE_URL": "https://listwell.dev",
    "POLAR_SERVER": "sandbox",
  },
}

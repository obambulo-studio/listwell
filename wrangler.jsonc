{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "listwell",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "listwell"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "listwell",
      // No database_id: a nil UUID is treated as a real remote id and Workers Builds fails.
      // Wrangler looks up or auto-provisions the D1 named `listwell`.
      "migrations_dir": "lib/db/migrations"
    }
  ],
  // Browser Rendering Workers binding. Used when a page looks like a thin SPA.
  "browser": {
    "binding": "BROWSER"
  },
  // Workers AI. LIST-3 report briefs call env.AI.run.
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      // No id: a placeholder namespace id fails Workers Builds the same way as a nil D1 id.
      // Wrangler looks up or auto-provisions AUDIT_KV.
      "binding": "AUDIT_KV"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AUDIT_QUEUE",
        "queue": "listwell-audit"
      }
    ]
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "vinext/server/fetch-handler",
  "name": "listwell",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-09",
  // Apex only. www.listwell.dev is the shared www-to-apex Worker
  // (0b0a8688c79a480c819d1604056d9bdf). Binding www here makes
  // `wrangler deploy` fight that Worker and fail Workers Builds.
  "routes": [
    {
      "pattern": "listwell.dev",
      "zone_name": "listwell.dev",
      "custom_domain": true,
    },
  ],
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "placement": {
    "mode": "smart",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },
  "cache": {
    "enabled": true,
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "listwell",
    },
  ],
  "browser": {
    "binding": "BROWSER",
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "images": {
    "binding": "IMAGES",
  },
  // Discover persists anonymous audits here when Convex is down.
  // No D1. Do not invent new KV/D1 UUIDs; this id is the live namespace.
  "kv_namespaces": [
    {
      "binding": "AUDIT_KV",
      "id": "06b74ff3aa6e41a9a5ea7a6eb365e711",
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"],
    },
    {
      "tag": "v2",
      "deleted_classes": ["DOQueueHandler"],
    },
  ],
"vars": {
    "CONVEX_DEPLOYMENT": "prod:fine-elephant-894",
    "NEXT_PUBLIC_CONVEX_SITE_URL": "https://fine-elephant-894.ap-southeast-2.convex.site",
    "NEXT_PUBLIC_CONVEX_URL": "https://fine-elephant-894.ap-southeast-2.convex.cloud",
    "NEXT_PUBLIC_SITE_URL": "https://listwell.dev",
    "POLAR_SERVER": "production",
    "SITE_URL": "https://listwell.dev",
    "USESEND_BASE_URL": "https://send.obambulo.studio",
    "USESEND_FROM": "Listwell <no-reply@t.listwell.dev>"
  },
  // Required for Workers Builds `npx wrangler preview` on non-main branches.
  // Workers Builds env + `--keep-vars` override Convex and secrets for preview.
  "previews": {
    "ai": {
      "binding": "AI",
    },
    "browser": {
      "binding": "BROWSER",
    },
    "images": {
      "binding": "IMAGES",
    },
    "kv_namespaces": [
      {
        "binding": "AUDIT_KV",
        "id": "06b74ff3aa6e41a9a5ea7a6eb365e711",
      },
    ],
    "observability": {
      "enabled": true,
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "persist": true,
      },
      "traces": {
        "enabled": true,
        "persist": true,
      },
    },
    "placement": {
      "mode": "smart",
    },
    "vars": {
      "CONVEX_DEPLOYMENT": "prod:fine-elephant-894",
      "NEXT_PUBLIC_CONVEX_SITE_URL": "https://fine-elephant-894.ap-southeast-2.convex.site",
      "NEXT_PUBLIC_CONVEX_URL": "https://fine-elephant-894.ap-southeast-2.convex.cloud",
      "NEXT_PUBLIC_SITE_URL": "https://listwell.dev",
      "POLAR_SERVER": "sandbox",
      "SITE_URL": "https://listwell.dev",
      "USESEND_BASE_URL": "https://send.obambulo.studio",
      "USESEND_FROM": "Listwell <no-reply@t.listwell.dev>",
    },
  },
}

# Required for chat listing lookup, Google Business Profile checks, Places search,
# Programmable Search social discovery, and CrUX then PageSpeed LCP.
GOOGLE_API_KEY=
GOOGLE_PROGRAMMABLE_SEARCH_ENGINE_ID=

# Optional. Apple Maps listing search and place details.
APPLE_MAPKIT_TEAM_ID=
APPLE_MAPKIT_KEY_ID=
APPLE_MAPKIT_PRIVATE_KEY=

# Optional. Browser Rendering REST fallback when the Workers binding is not enough.
LISTWELL_BROWSER_RENDERING_ACCOUNT_ID=
LISTWELL_BROWSER_RENDERING_API_TOKEN=

# Polar payments (Merchant of Record).
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_REPORT_ONCE=
POLAR_PRODUCT_REPORT_MONTHLY=
POLAR_SERVER=sandbox

# useSend transactional mail for Better Auth email OTP sign-in codes.
# Set USESEND_API_KEY, USESEND_FROM, and USESEND_BASE_URL on the Convex deployment.
# USESEND_FROM must use a domain verified in your UseSend instance.
USESEND_API_KEY=
USESEND_FROM=Listwell <no-reply@your-verified-domain>
# USESEND_BASE_URL=https://app.usesend.com

# Convex (from `npx convex dev` — also set on Convex deployment)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Better Auth / app URLs (set SITE_URL and BETTER_AUTH_SECRET on Convex too)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Shared secret for Next.js ↔ Convex internal mutations and scheduled scan callbacks
# Must match the value set with `npx convex env set INTERNAL_API_SECRET`
INTERNAL_API_SECRET=

# Optional. API token with Workers CI Write for `bun run cf:sync-build-env`.
# CLOUDFLARE_API_TOKEN=

# Local next dev: use in-memory audits/KV and avoid remote binding auth errors.
# SKIP_OPENNEXT_DEV=1

# Optional. Google Places, CrUX, PageSpeed, and Programmable Search.
# Used server-side for create-audit search and report checks. Do not expose to the browser.
GOOGLE_API_KEY=
GOOGLE_PROGRAMMABLE_SEARCH_ENGINE_ID=

